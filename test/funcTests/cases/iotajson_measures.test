  "id": "urn:ngsi-ld:Thermometer:th1",
  "type": "Thermometer",
  "temperature": {
    "type": "Property",
    "value": 30,
    "unitCode": "CEL",
    "observedAt": "2026-10-20T21:10:00Z"
  },
  "h": {
    "type": "Property",
